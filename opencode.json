{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "subagent_depth": 0,
  "compaction": {
    "auto": true
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "coverage/**",
      ".angular/**",
      ".venv/**"
    ]
  },
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "external_directory": "ask"
  }
}